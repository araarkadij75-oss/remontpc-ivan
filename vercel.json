{
  "version": 2,
  "public": true,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/leads.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/leads", "dest": "/api/leads.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
